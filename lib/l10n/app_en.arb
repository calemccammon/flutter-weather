  "failureTimeout": "The weather service took too long to answer.",
  "@failureTimeout": {
    "description": "Error: the request timed out."
  },
  "failureNoConnection": "Could not reach the weather service. Check your connection.",
  "@failureNoConnection": {
    "description": "Error: no network, or the service is down."
  },
  "failureBadResponse": "The weather service sent an answer this app could not read.",
  "@failureBadResponse": {
    "description": "Error: the response was not in the expected shape."
  },
  "failureRejected": "The weather service refused the request.",
  "@failureRejected": {
    "description": "Error: the service answered with an error."
